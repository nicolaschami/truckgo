<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TruckGo.Core: the code shared by the API (driver app) and the back office.
      Data/         the database: entities, DbContext, migrations, demo data
      Integration/  the one door for master data from the other system
      Admin/        TruckGo's own data management (users, settings...)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- For PasswordHasher (PINs and passwords are stored hashed) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
