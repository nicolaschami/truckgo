@page "/account/change-password"
@attribute [Authorize(Policy = Policies.ChangePassword)]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.ComponentModel.DataAnnotations
@inject UserAdmin Users
@inject NavigationManager Nav

@* Choosing a new password. Forced after a temporary password (new user or
   reset by an Admin); also reachable from the user menu at any time. *@

<PageTitle>New password · TruckGo</PageTitle>

<h1>Choose a new password</h1>

@if (HttpContext.User.MustChangePasswordFirst())
{
    <p class="account-hint">You are using a temporary password. Choose your own to continue.</p>
}

@if (_error is not null)
{
    <div class="account-error" role="alert">@_error</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" OnInvalidSubmit="ForgetPasswords" FormName="change-password">
    <DataAnnotationsValidator />

    <label for="current">Current password</label>
    <InputText id="current" type="password" @bind-Value="Input!.Current" autocomplete="current-password" autofocus />
    <ValidationMessage For="() => Input!.Current" />

    <label for="new">New password <small>(at least @LoginRules.MinPasswordLength characters)</small></label>
    <InputText id="new" type="password" @bind-Value="Input!.New" autocomplete="new-password" />
    <ValidationMessage For="() => Input!.New" />

    <label for="confirm">New password again</label>
    <InputText id="confirm" type="password" @bind-Value="Input!.Confirm" autocomplete="new-password" />
    <ValidationMessage For="() => Input!.Confirm" />

    <button type="submit">Save my new password</button>
</EditForm>

<form method="post" action="account/logout">
    <AntiforgeryToken />
    <button type="submit" class="link-button">Log out</button>
</form>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Filled from the posted form; empty when the page is first shown
    [SupplyParameterFromForm] private PasswordInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private string? _error;

    private async Task ChangeAsync()
    {
        try
        {
            var user = await Users.ChangePasswordAsync(HttpContext.User.UserId(), Input!.Current, Input!.New);

            // Sign in again without the "temporary password" mark: every screen opens now
            await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme,
                BackOfficeClaims.Create(user, user.Company?.Name));
            Nav.NavigateTo("/");
        }
        catch (AdminException e)
        {
            _error = e.Message;
            ForgetPasswords();
        }
    }

    // Never send typed passwords back in the page when it shows again
    private void ForgetPasswords()
    {
        Input!.Current = "";
        Input.New = "";
        Input.Confirm = "";
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Please enter your current password.")]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "Please enter a new password.")]
        [MinLength(LoginRules.MinPasswordLength, ErrorMessage = "The new password is too short.")]
        public string New { get; set; } = "";

        [Compare(nameof(New), ErrorMessage = "The two new passwords are not the same.")]
        public string Confirm { get; set; } = "";
    }
}
