@inherits LayoutComponentBase

@* The login and "new password" pages — the first thing a user sees.
   Left (hidden on a phone): the TruckGo brand and a small live-looking map
   that tells what TruckGo does: a truck driving from the plant to the site,
   with the geofence circles and status cards. Right: the form.
   Plain HTML + app.css + one inline SVG, because these pages are not live
   (see App.razor). *@

<main class="account-page">
    <section class="account-hero" aria-hidden="true">
        <div class="hero-brand">
            <span class="brand-mark">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9 1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            </span>
            <span class="brand-name">TruckGo</span>
        </div>

        <div class="hero-main">
            <span class="hero-kicker"><span class="live-dot"></span> Live delivery tracking</span>
            <h2>Every delivery,<br /><span class="hero-accent">from plant to site.</span></h2>
            <p>See where every truck is, how long it waits, and when it arrives — with signed proof for every load.</p>

            @* ---- The mini-map ---- *@
            <div class="hero-map">
                <svg viewBox="0 0 520 250" class="map-svg">
                    <defs>
                        <pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse">
                            <circle cx="1.5" cy="1.5" r="1.2" fill="rgba(148,163,184,.18)" />
                        </pattern>
                        <linearGradient id="routeGlow" x1="0" x2="1">
                            <stop offset="0" stop-color="#60A5FA" />
                            <stop offset="1" stop-color="#F59E0B" />
                        </linearGradient>
                    </defs>

                    <rect width="520" height="250" fill="url(#dots)" />

                    @* Faint roads *@
                    <path d="M0 200 C 120 180, 180 230, 300 205 S 470 160, 520 175" stroke="rgba(148,163,184,.14)" stroke-width="6" fill="none" />
                    <path d="M150 0 C 160 80, 120 150, 170 250" stroke="rgba(148,163,184,.10)" stroke-width="5" fill="none" />
                    <path d="M380 0 C 360 70, 420 120, 400 250" stroke="rgba(148,163,184,.10)" stroke-width="5" fill="none" />

                    @* The route: plant (left) → site (right) *@
                    <path id="route" d="M88 150 C 170 60, 260 210, 340 120 S 420 70, 440 92"
                          stroke="url(#routeGlow)" stroke-width="4" stroke-linecap="round" fill="none" stroke-dasharray="2 10" />

                    @* Plant with its geofence *@
                    <circle cx="88" cy="150" r="34" class="geofence geofence-plant" />
                    <circle cx="88" cy="150" r="16" fill="#1E3A8A" stroke="#60A5FA" stroke-width="2" />
                    <path transform="translate(78 140) scale(.85)" fill="#BFDBFE" d="M2 22V10l6 3V9l6 3V4h8v18H2zm4-3h3v-3H6v3zm5 0h3v-3h-3v3zm5 0h3v-3h-3v3z" />

                    @* Site with its geofence *@
                    <circle cx="440" cy="92" r="34" class="geofence geofence-site" />
                    <circle cx="440" cy="92" r="16" fill="#78350F" stroke="#F59E0B" stroke-width="2" />
                    <path transform="translate(431 82) scale(.8)" fill="#FDE68A" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />

                    @* The truck, driving along the route *@
                    <g class="map-truck">
                        <circle r="15" fill="#F59E0B" />
                        <circle r="15" fill="none" stroke="rgba(245,158,11,.35)" stroke-width="8" />
                        <path transform="translate(-9 -9) scale(.75)" fill="#0B1F3A" d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9 1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
                        <animateMotion dur="9s" repeatCount="indefinite" rotate="0" keyPoints="0;1;1" keyTimes="0;.85;1" calcMode="linear">
                            <mpath href="#route" />
                        </animateMotion>
                    </g>

                    <text x="88" y="205" class="map-label" text-anchor="middle">Plant QN2</text>
                    <text x="440" y="146" class="map-label" text-anchor="middle">Riverside Arena</text>
                </svg>

                @* Floating status cards *@
                <div class="float-card float-top">
                    <span class="status-dot status-blue"></span>
                    <div>
                        <strong>AB-1234 · In transit</strong>
                        <span>24.6 t · 22.8 km to site</span>
                    </div>
                </div>
                <div class="float-card float-bottom">
                    <span class="status-dot status-green"></span>
                    <div>
                        <strong>Arrived at site</strong>
                        <span>On time · signed by D. Whitfield</span>
                    </div>
                </div>
            </div>

            <div class="hero-points">
                <span><b>Live board</b> of every truck</span>
                <span><b>Automatic</b> arrival at the plant</span>
                <span><b>Signed</b> proof of delivery</span>
            </div>
        </div>

        <div class="hero-foot">© @DateTime.UtcNow.Year TruckGo</div>
    </section>

    <section class="account-form">
        <div class="account-card">
            <div class="account-brand-small">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9 1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
                </span>
                TruckGo
            </div>
            <div class="account-body">
                @Body
                <div class="secure-note">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm3 11c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
                    Secure login · your password is never stored in clear
                </div>
            </div>
        </div>
    </section>
</main>
