@inject IJSRuntime JS

@* Shows a generated secret (temporary password, later a driver's PIN) ONE
   time. Only its hash is stored, so after this dialog nobody can see it
   again — a forgotten one is simply reset. *@

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">@Message</MudText>
        <div class="secret-once">@Secret</div>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
            Write it down or copy it now: it will not be shown again.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">
            @(_copied ? "Copied" : "Copy")
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string Secret { get; set; } = "";

    private bool _copied;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Secret);
            _copied = true;
        }
        catch (JSException)
        {
            // The browser refused (e.g. not https): the secret is still on screen to copy by hand
        }
    }
}
